{
  "framework": "angular",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/quackroom-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quackroom-backend.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
